{
    "name": "shipkit-bd/laravel-courier-bd",
    "description": "Unified Bangladeshi Courier Package for Laravel (Pathao, RedX, Steadfast)",
    "keywords": [
        "laravel",
        "courier",
        "bangladesh",
        "pathao",
        "redx",
        "steadfast",
        "shipping",
        "ecommerce"
    ],
    "homepage": "https://github.com/atikhasan2090/laravel-courier-bd",
    "readme": "README.md",
    "license": "MIT",
    "authors": [
        {
            "name": "Laravel Courier BD Team",
            "email": "info@shipkit.bd"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Shipkit\\CourierBD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipkit\\CourierBD\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shipkit\\CourierBD\\ShipkitServiceProvider"
            ],
            "aliases": {
                "Courier": "Shipkit\\CourierBD\\Facades\\Courier"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
